[Unit]
Description=Bot de WhatsApp - Abarrotes Hernandez
After=network.target

[Service]
User=www-data
WorkingDirectory=/opt/abarrotes-bot
EnvironmentFile=/opt/abarrotes-bot/.env
ExecStart=/opt/abarrotes-bot/venv/bin/gunicorn -w 2 --threads 4 -b 127.0.0.1:5000 app:app
Restart=always

[Install]
WantedBy=multi-user.target
